{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "rangeStrategy": "bump",
  "constraints": {
    "node": "24"
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["spec/package.json", "spec/package-lock.json"],
      "groupName": "spec validator dependencies"
    }
  ]
}
