{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utcs.tax/schemas/classification-request.schema.json",
  "title": "Classification Request",
  "description": "Request body for POST /tax-codes/classify. Each product MUST carry a natural-language description or an item code. A provider that cannot classify a product MUST return UTCS-4002 and MUST NOT invent a code.",
  "type": "object",
  "properties": {
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Natural-language product description."
          },
          "item_code": { "type": "string" },
          "upc": { "type": "string" },
          "category": {
            "type": "string",
            "description": "Product category hint."
          }
        },
        "anyOf": [
          { "required": ["description"] },
          { "required": ["item_code"] }
        ]
      }
    },
    "jurisdiction": {
      "type": "string",
      "description": "Target jurisdiction. Tax codes may vary by jurisdiction."
    }
  },
  "required": ["products"]
}
